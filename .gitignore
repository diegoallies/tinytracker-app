#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/

# iOS / Xcode build artifacts
ios/build/
**/DerivedData/
**/*.xcuserstate
**/xcuserdata/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.claude/settings.local.json

# Signing / sender secrets. The Firebase service-account JSON can send push as
# this app, and the APNs .p8 is one-time-download — neither belongs in git.
# (firebase_options.dart, google-services.json and GoogleService-Info.plist are
# client identifiers, not secrets, and ARE committed on purpose.)
*-firebase-adminsdk-*.json
*.p8
