# TinyTrack — iOS release automation
#
# Auth uses an App Store Connect API key (no 2FA prompts, works unattended).
# Put your key file at ios/fastlane/AuthKey.p8 and set ASC_KEY_ID / ASC_ISSUER_ID
# in ios/fastlane/.env.default (both files are gitignored).
#
# Usage (from the ios/ directory):
#   fastlane beta      # build + upload to TestFlight (UAT)
#   fastlane release   # build + submit to the App Store for review

require "shellwords"

default_platform(:ios)

# Absolute paths so lanes work no matter where fastlane is invoked from.
PROJECT_ROOT = File.expand_path("../..", __dir__)          # .../Tiny Tracker
IPA_DIR      = File.join(PROJECT_ROOT, "build/ios/ipa")
IPA_PATH     = File.join(IPA_DIR, "TinyTrack.ipa")

# pubspec.yaml is the single source of truth for the version, so read it rather
# than letting deliver guess which build to submit.
def flutter_version
  raw = File.read(File.join(PROJECT_ROOT, "pubspec.yaml"))[/^version:\s*(\S+)/, 1]
  UI.user_error!("Could not read `version:` from pubspec.yaml") if raw.nil?
  name, build = raw.split("+")
  UI.user_error!("pubspec version '#{raw}' has no +buildNumber") if build.nil?
  { name: name, build: build }
end

# Load the App Store Connect API key once per run.
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path("AuthKey.p8", __dir__),
    duration: 1200,
    in_house: false,
  )
end

platform :ios do
  # Compile the Flutter side (Dart + assets + pods). No signing here — gym signs.
  private_lane :flutter_compile do
    Dir.chdir(PROJECT_ROOT) do
      sh("flutter", "pub", "get")
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end
  end

  # xcargs for gym. `-allowProvisioningUpdates` alone only works on a machine
  # where Xcode is signed in with an Apple ID — true locally, false on CI. Pass
  # the App Store Connect API key explicitly so automatic signing also works on
  # a fresh build machine (Codemagic) with no Xcode account.
  def signing_xcargs
    args = ["-allowProvisioningUpdates"]
    key_path = File.expand_path("AuthKey.p8", __dir__)
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && File.exist?(key_path)
      args << "-authenticationKeyID #{ENV['ASC_KEY_ID']}"
      args << "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
      args << "-authenticationKeyPath #{key_path.shellescape}"
    end
    args.join(" ")
  end

  # Archive + export a signed App Store IPA via gym (more robust than flutter's
  # own export, which can fail on the embedded Watch app).
  private_lane :build_ipa do
    flutter_compile
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: IPA_DIR,
      output_name: "TinyTrack.ipa",
      xcargs: signing_xcargs,
      clean: false,
    )
  end

  desc "Build and upload to TestFlight (UAT)"
  lane :beta do
    key = asc_key
    build_ipa
    upload_to_testflight(
      api_key: key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
    )
    UI.success("✅ Uploaded to TestFlight. It'll appear under TestFlight in App Store Connect after processing.")
  end

  # Push the "What's New" text for the version currently being prepared.
  #
  # App Store Connect refuses to accept a new version for review with an empty
  # whatsNew, and `skip_metadata: true` means deliver never sends one — which is
  # why release used to die at "You must provide a value for the attribute
  # 'whatsNew'". We deliberately do NOT flip skip_metadata to false: that makes
  # deliver push the WHOLE listing from disk, and with only release_notes.txt
  # present it can blank out the description, keywords and promo text on the live
  # page. Setting the single field via Spaceship touches nothing else.
  #
  # Text lives in fastlane/metadata/en-US/release_notes.txt so it is reviewable in
  # git rather than typed into a web form each release.
  private_lane :push_release_notes do |options|
    notes_path = File.expand_path("metadata/en-US/release_notes.txt", __dir__)
    unless File.exist?(notes_path)
      UI.important("No release_notes.txt found - skipping whatsNew. Submission will fail if this is a new version.")
      next
    end
    notes = File.read(notes_path).strip
    if notes.empty?
      UI.important("release_notes.txt is empty - skipping whatsNew.")
      next
    end
    # App Store Connect caps this field at 4000 characters.
    UI.user_error!("release_notes.txt is #{notes.length} chars; the limit is 4000") if notes.length > 4000

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:key])
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
    )
    UI.user_error!("App not found in App Store Connect") if app.nil?

    version = app.get_edit_app_store_version
    UI.user_error!("No editable version found - upload a build first") if version.nil?

    localizations = version.get_app_store_version_localizations
    UI.user_error!("Version #{version.version_string} has no localizations") if localizations.empty?

    # Prefer en-US; fall back to whatever locales exist so this doesn't break if
    # the app is ever localised differently.
    targets = localizations.select { |l| l.locale == "en-US" }
    targets = localizations if targets.empty?
    targets.each do |loc|
      loc.update(attributes: { whatsNew: notes })
      UI.success("Set release notes for #{version.version_string} (#{loc.locale})")
    end
  end

  desc "Build and submit to the App Store for review"
  lane :release do
    key = asc_key
    v = flutter_version
    build_ipa

    # Split into upload → set notes → submit. The version has to exist in App
    # Store Connect before whatsNew can be written to it, and it only exists once
    # a binary has been uploaded against it.
    upload_to_app_store(
      api_key: key,
      ipa: IPA_PATH,
      app_version: v[:name],
      skip_screenshots: true,   # screenshots/metadata are managed manually in ASC
      skip_metadata: true,
      submit_for_review: false, # deliberately not yet - notes come first
      force: true,
      precheck_include_in_app_purchases: false,
    )

    push_release_notes(key: key)

    # Submit, pinned to the exact build just uploaded.
    #
    # app_version + build_number are NOT optional here. Apple takes 5-15 minutes
    # to process a binary, and without pinning, deliver submits whichever build
    # happens to be attached to the version - which can be the PREVIOUS one,
    # silently shipping the wrong binary. Pinned, a still-processing build fails
    # loudly instead, and you re-run once it's ready.
    upload_to_app_store(
      api_key: key,
      app_version: v[:name],
      build_number: v[:build],
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: true,  # auto-release once Apple approves
      force: true,
      precheck_include_in_app_purchases: false,
    )
    UI.success("✅ Submitted #{v[:name]} (#{v[:build]}) to the App Store for review.")
  end

  desc "Set the What's New text from release_notes.txt without building or submitting"
  lane :notes do
    push_release_notes(key: asc_key)
  end

  desc "List the most recent uploaded builds and their processing state"
  lane :builds do
    key = asc_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
    )
    UI.user_error!("App not found") if app.nil?
    app.get_builds(includes: "preReleaseVersion", limit: 8).each do |b|
      ver = b.pre_release_version&.version
      UI.message("build #{b.version}  (#{ver})  state=#{b.processing_state}  uploaded=#{b.uploaded_date}")
    end
  end

  desc "Show the current review submission state and which build is attached"
  lane :status do
    key = asc_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: key)
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))

    version = app.get_edit_app_store_version(includes: "build")
    if version
      UI.message("Version #{version.version_string}: #{version.app_store_state}")
      UI.message("Attached build: #{version.build ? version.build.version : '(none)'}")
    else
      UI.message("No editable version found.")
    end

    submission = app.get_in_progress_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)
    if submission
      UI.message("Review submission #{submission.id}: #{submission.state}, submitted #{submission.submitted_date}")
    else
      UI.message("No in-progress review submission.")
    end
  end

  desc "Cancel a stuck/rejected review submission and resubmit the already-uploaded build"
  lane :resubmit do
    key = asc_key
    token = Spaceship::ConnectAPI::Token.from(hash: key)
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found") if app.nil?

    submission = app.get_in_progress_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)
    if submission
      UI.important("Cancelling in-progress review submission #{submission.id} (state: #{submission.state})")
      submission.cancel_submission
      UI.success("✅ Cancelled the stuck submission.")
    else
      UI.message("No in-progress review submission found - nothing to cancel.")
    end

    # Resubmit the latest processed build without rebuilding or re-uploading.
    upload_to_app_store(
      api_key: key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
    )
    UI.success("✅ Resubmitted to the App Store for review.")
  end
end
